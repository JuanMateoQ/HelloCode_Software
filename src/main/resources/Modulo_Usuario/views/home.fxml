<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Modulo_Usuario.Controladores.HomeController"
            prefWidth="360.0" prefHeight="720.0"
            style="-fx-background-color: #424874;">
    <VBox alignment="CENTER" spacing="36" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
        <padding>
            <Insets top="60" right="24" bottom="24" left="24"/>
        </padding>

        <Label text="Bienvenido"
               style="-fx-text-fill: #DCD6F7; -fx-font-size: 26px; -fx-font-weight: bold;"/>

        <Label text="¿Qué módulo deseas usar?"
               style="-fx-text-fill: #A6B1E1; -fx-font-size: 16px;"/>

        <VBox spacing="24" alignment="CENTER">
            <Button text="Módulo Lección"
                    style="-fx-background-color: #A6B1E1; -fx-text-fill: #424874; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 12;"
                    prefWidth="220" prefHeight="60"
                    onAction="#abrirLeccion"/>
            <Button text="Módulo Usuarios"
                    style="-fx-background-color: #DCD6F7; -fx-text-fill: #424874; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 12;"
                    prefWidth="220" prefHeight="60"
                    onAction="#abrirUsuarios"/>
        </VBox>
    </VBox>
</AnchorPane> 